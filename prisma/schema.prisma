generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  WAITING_FOR_PARTS
  IN_REPAIR
  TESTING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentType {
  DEPOSIT
  PAYMENT
  REFUND
}

enum PartMovementType {
  PURCHASE
  USED_IN_REPAIR
  RETURNED
  ADJUSTMENT
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  EMPLOYEE
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}
enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
model Shop {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  isActive  Boolean  @default(true)
    plan            SubscriptionPlan?
  trialEndsAt     DateTime?
  subscribedUntil DateTime?
    shopNumber      Int               @unique @default(autoincrement())
  paymentRequests SubscriptionPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  devices   Device[]
  repairs   RepairOrder[]
  parts     Part[]
}

model User {
  id                 String    @id @default(cuid())
  shopId             String?
  username           String    @unique
  name               String
  passwordHash       String
  role               UserRole  @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop               Shop?     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Customer {
  id        String        @id @default(cuid())
  shopId    String?
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  shop      Shop?         @relation(fields: [shopId], references: [id])
  repairs   RepairOrder[]

  @@index([shopId])
  @@index([phone])
  @@index([name])
}

model Device {
  id           String        @id @default(cuid())
  shopId       String?
  brand        String
  model        String
  serialNumber String?
  color        String?
  createdAt    DateTime      @default(now())

  shop         Shop?         @relation(fields: [shopId], references: [id])
  repairs      RepairOrder[]

  @@index([shopId])
  @@index([serialNumber])
}

model RepairOrder {
  id                  String                @id @default(cuid())
  repairNumber        Int                   @unique @default(autoincrement())
  shopId              String?
  customerId          String
  deviceId            String
  problemDescription  String
  diagnosis           String?
  repairNotes         String?
  status              RepairStatus          @default(RECEIVED)
  estimatedCost       Decimal?              @db.Decimal(10, 2)
  finalCost           Decimal?              @db.Decimal(10, 2)
  receivedAt          DateTime              @default(now())
  estimatedCompletion DateTime?
  completedAt         DateTime?
  deliveredAt         DateTime?
  trackingToken       String                @unique @default(cuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  shop                Shop?                 @relation(fields: [shopId], references: [id])
  customer            Customer              @relation(fields: [customerId], references: [id])
  device              Device                @relation(fields: [deviceId], references: [id])
  statusHistory       RepairStatusHistory[]
  partsUsed           RepairPart[]
  payments            Payment[]

  @@index([shopId, status])
  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

model RepairStatusHistory {
  id            String       @id @default(cuid())
  repairOrderId String
  status        RepairStatus
  note          String?
  createdAt     DateTime     @default(now())

  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId, createdAt])
}

model Part {
  id            String        @id @default(cuid())
  shopId        String?
  name          String
  sku           String?
  description   String?
  purchasePrice Decimal       @default(0) @db.Decimal(10, 2)
  sellingPrice  Decimal       @default(0) @db.Decimal(10, 2)
  stock         Int           @default(0)
  minStock      Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop          Shop?         @relation(fields: [shopId], references: [id])
  repairs       RepairPart[]

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([name])
}

model RepairPart {
  id            String      @id @default(cuid())
  repairOrderId String
  partId        String
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  part          Part        @relation(fields: [partId], references: [id])

  @@unique([repairOrderId, partId])
}

model Payment {
  id            String        @id @default(cuid())
  repairOrderId String
  amount        Decimal       @db.Decimal(10, 2)
  type          PaymentType   @default(PAYMENT)
  method        PaymentMethod @default(CASH)
  note          String?
  paidAt        DateTime      @default(now())

  repairOrder   RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId, paidAt])
}

model SubscriptionPayment {
  id          String               @id @default(cuid())
  shopId      String
  plan        SubscriptionPlan
  receiptPath String
  receiptMime String
  status      PaymentRequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime             @default(now())
  reviewedAt  DateTime?

  shop        Shop                 @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
}